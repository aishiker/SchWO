  "flux_and_current_definition": {
    "fourier_convention": "exp(-i omega t)",
    "real_field_peak_time_average_factor": "1/2",
    "sigma_l": "(ell+2)!/(ell-2)!",
    "martel_poisson_mode_flux": "F=sigma_l*omega^2*abs(Psi_MP)^2/(128*pi)",
    "signed_radial_current": "J=(Psi_conjugate*d_rstar(Psi)-Psi*d_rstar(Psi_conjugate))/(2i)",
    "asymptotic_currents": {
      "incoming": "J_in=-omega*abs(A_in_MP)^2",
      "total_outgoing": "J_out=+omega*abs(A_out_total_MP)^2",
      "future_horizon": "J_h=-omega*abs(T_horizon_MP)^2"
    },
    "current_to_energy_flux": "F=sigma_l*omega*abs(J)/(128*pi)",
    "balance_equation": "F_infinity_in=F_infinity_out_total+F_horizon",
    "odd_bridge": "Psi_CPM=(2i/omega) Psi_RW under exp(-i omega t)",
    "normalization": "multiply every incoming, total-outgoing and horizon raw coefficient by the same N_lm^p=c_lm^p/A_in_raw and the sector MP bridge",
    "scattered_only_balance_forbidden": true,
    "free_and_scattered_flux_qualification": "diagnostic only; their interference prevents treating them as independent positive balance terms"
  },
  "comparator_definitions": {
    "normalized_balance_residual": {
      "formula": "abs(F_in-F_out_total-F_horizon)/F_in",
      "units": "dimensionless"
    },
    "waveform_vs_current_relative_flux_residual": {
      "formula": "abs(F_MP-F_current)/max(F_MP,F_current)",
      "units": "dimensionless",
      "mandatory_for": "incoming, total-outgoing and horizon flux for every selected record"
    },
    "route_A_B_total_outgoing_flux_fraction_difference": {
      "formula": "abs(F_out_total_A-F_out_total_B)/F_in",
      "units": "dimensionless"
    },
    "schwo_external_total_outgoing_flux_fraction_difference": {
      "formula": "abs(F_out_schwo/F_in_schwo-F_out_external/F_in_external)",
      "units": "dimensionless"
    },
    "schwo_external_horizon_flux_symmetric_relative_difference": {
      "formula": "abs(f_h_schwo-f_h_external)/max(f_h_schwo,f_h_external), where f_h=F_horizon/F_in",
      "units": "dimensionless",
      "arbitrary_precision_required": true,
      "zero_or_floor_omission_forbidden": true
    }
  },
